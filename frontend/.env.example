# Supabase (public anon key only — never use service role key on the frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Splitwise

# PWA — set to true for installable app (uses webpack build on Vercel)
NEXT_PUBLIC_ENABLE_PWA=false

# ---------------------------------------------------------------------------
# Supabase Edge Functions — email (set via CLI, never in frontend .env):
#
# Gmail SMTP (recommended if not using Resend):
#   supabase secrets set SMTP_HOST=smtp.gmail.com
#   supabase secrets set SMTP_PORT=587
#   supabase secrets set SMTP_USER=your@gmail.com
#   supabase secrets set SMTP_PASS=your-16-char-app-password
#   supabase secrets set SMTP_FROM_EMAIL="Splitwise <your@gmail.com>"
#   supabase secrets set SMTP_REPLY_TO=your@gmail.com
#   supabase secrets set APP_NAME=Splitwise
#   supabase secrets set APP_URL=http://localhost:3000
#
# Resend (alternative):
#   supabase secrets set RESEND_API_KEY=re_xxx
#   supabase secrets set RESEND_FROM_EMAIL="Bitwisse <invites@yourdomain.com>"
#   supabase secrets set APP_URL=http://localhost:3000
#
# Deploy: supabase functions deploy invitations
# See docs/invitations/ARCHITECTURE.md
#
# Local Supabase (Authentication → URL Configuration):
#   Site URL:        http://localhost:3000
#   Redirect URLs:   http://localhost:3000/auth/callback
#                    http://localhost:3000/auth/callback/**
#
# Production / Vercel — replace with your Vercel URL, e.g. https://your-app.vercel.app
#   Site URL:        https://your-app.vercel.app
#   Redirect URLs:
#     https://your-app.vercel.app/auth/callback
#     https://your-app.vercel.app/auth/callback/**
#     https://*.vercel.app/auth/callback
#     https://*.vercel.app/auth/callback/**
#
# Important: If `/auth/callback` is missing from Redirect URLs, Google OAuth
# falls back to Site URL (the landing page `/`) instead of the dashboard.
# Google OAuth (Authentication → Providers → Google):
#   1. Create OAuth credentials in Google Cloud Console
#   2. Authorized redirect URI must be:
#        https://<PROJECT_REF>.supabase.co/auth/v1/callback
#   3. Paste Client ID + Client Secret into Supabase Google provider settings
#   4. Enable the Google provider
#   App callback stays NEXT_PUBLIC_APP_URL/auth/callback (already used by getAuthCallbackUrl)
#
# After enabling Google, apply DB migration for profile ensure:
#   supabase db push
#   (includes 20260718160000_google_auth_profile_ensure.sql)
#
# Apply database migrations from /supabase/migrations (see supabase/README.md)
# ---------------------------------------------------------------------------
