# Supabase (public anon key only — never use service role key on the frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Splitwise

# PWA — set to true for installable app (uses webpack build on Vercel)
NEXT_PUBLIC_ENABLE_PWA=false

# ---------------------------------------------------------------------------
# Local Supabase (Authentication → URL Configuration):
#   Site URL:        http://localhost:3000
#   Redirect URLs:   http://localhost:3000/auth/callback
#
# Production / Vercel — replace with your Vercel URL, e.g. https://your-app.vercel.app
#   Site URL:        https://your-app.vercel.app
#   Redirect URLs:
#     https://your-app.vercel.app/auth/callback
#     https://*.vercel.app/auth/callback
#
# Apply database migrations from /supabase/migrations (see supabase/README.md)
# ---------------------------------------------------------------------------
